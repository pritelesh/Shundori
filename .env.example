# ---------------------------------------------------------------------------
# Shundori — environment variables
#
# Copy this file to .env.local and fill in your own values:
#   PowerShell: Copy-Item .env.example .env.local
#   macOS/Linux: cp .env.example .env.local
#
# Never commit .env.local or any real credentials.
# ---------------------------------------------------------------------------

# Public site URL, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — public values
#
# Safe to expose to the browser. Access is controlled by Row Level Security.
# Find these in Supabase Dashboard → Project Settings → API.
# Leave both blank to run the labelled Phase 3 demonstration catalogue.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — server only
#
# SECURITY: This key bypasses Row Level Security. Never prefix it with
# NEXT_PUBLIC_, never import it into Client Components, and never commit it.
# It is required by the admin dashboard and server-side COD order placement.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional live verification users for `npm run verify:supabase`.
# Use throwaway users in a non-production project. Never use real credentials.
# ---------------------------------------------------------------------------
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PASSWORD=
TEST_OTHER_ORDER_ID=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_PRODUCT_ID=

# ---------------------------------------------------------------------------
# Production notes
#
# Set NEXT_PUBLIC_SITE_URL to the final approved domain before deploying.
# In Vercel, SUPABASE_SERVICE_ROLE_KEY is a server-only environment variable;
# never add a NEXT_PUBLIC_ service-role variable.
#
# `npm run create:admin` reads ADMIN_EMAIL and ADMIN_PASSWORD from the shell.
# Do not add a real ADMIN_PASSWORD to this file or to any committed file.
# ---------------------------------------------------------------------------
